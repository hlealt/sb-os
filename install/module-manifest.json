          "module": "para",
          "source_template": "para/commands/sb-inject-context.md",
          "target": ".claude/commands/sb-inject-context.md"
        },
        {
          "name": "sb-onboarder",
          "module": "para",
          "source_template": "para/commands/sb-onboarder.md",
          "target": ".claude/commands/sb-onboarder.md"
        }
      ],
      "rules": [
        {
          "name": "sb-obsidian-markdown",
          "module": "para",
          "source": "para/rules/sb-obsidian-markdown.md",
          "target": ".claude/rules/sb-obsidian-markdown.md",
          "mode": "copy",
          "description": "Obsidian-flavored markdown reference (callouts, embeds, frontmatter)."
        },
        {
          "name": "sb-sub-agents",
          "module": "para",
          "source": "para/rules/sb-sub-agents.md",
          "target": ".claude/rules/sb-sub-agents.md",
          "mode": "copy",
          "description": "Pre-dispatch gate for Agent tool calls."
        },
        {
          "name": "sb-user-preferences",
          "module": "para",
          "source": "para/rules/sb-user-preferences.md",
          "target": ".claude/rules/sb-user-preferences.md",
          "mode": "copy",
          "description": "Loads .user/profile/preferences.md if present.",
          "stale": true,
          "stale_reason": "Superseded by host CLAUDE.md preferences + per-workflow context-injection (sb-workflow-context). The always-on monolithic loader cost context on every turn for content most turns don't need; cross-cutting prefs belong in CLAUDE.md, workflow-scoped prefs in per-workflow context YAMLs."
        },
        {
          "name": "sb-workflow-context",
          "module": "para",
          "source": "para/rules/sb-workflow-context.md",
          "target": ".claude/rules/sb-workflow-context.md",
          "mode": "copy",
          "description": "YAML context injection on workflow steps from user_context_root."
        },
        {
          "name": "sb-source-of-truth",
          "module": "para",
          "source": "para/rules/sb-source-of-truth.md",
          "target": ".claude/rules/sb-source-of-truth.md",
          "mode": "copy",
          "description": "Warns that sb-os components in .claude/ are overwritten on re-install."
        }
      ],
      "templates": [
        {
          "name": "periodic-daily",
          "module": "para",
          "source": "para/templates/periodic-notes/Daily.md",
          "target": ".user/config/templates/periodic-notes/Daily.md",
          "description": "Obsidian daily note template (install-if-missing)."
        },
        {
          "name": "periodic-weekly",
