{
  "version": 3,
  "description": "sb-os component manifest. Declarative source of truth for every shippable component the installer renders into a target vault. Edit this file to add, remove, or rename a component; loaders.py reads from here. Components are grouped into modules; each component declares a `module` field naming the on-disk module folder (`para` or `wiki`) that owns its source. Source paths under `source` and `source_template` are relative to the sb-os repo root and MUST start with the module folder name. The `wiki` module is atomic — selecting it installs all of its components AND creates the wiki folder + wiki CLAUDE.md; deselecting it skips all of them. Component kinds: skills/commands/rules are rewritten on every install (loader and rule-copy semantics). Templates use install-if-missing semantics — they are copied on fresh install, AND on upgrade only when the target file does not exist. Templates are never overwritten so user customizations are preserved across upgrades.",
  "modules": {
    "core": {
      "description": "Core vault operations and behavioral rules. Always installed. Sources live under the para/ module folder.",
      "always_installed": true,
      "atomic": false,
      "skills": [
        {
          "name": "sb-vault-ops",
          "module": "para",
          "source_template": "para/skills/sb-vault-ops/SKILL.md",
          "target": ".claude/skills/sb-vault-ops/SKILL.md"
        },
        {
          "name": "sb-vault-integrity",
          "module": "para",
          "source_template": "para/skills/sb-vault-integrity/SKILL.md",
          "target": ".claude/skills/sb-vault-integrity/SKILL.md"
        }
      ],
      "commands": [
